  "facts": {
    "summary": {
      "en": "A long point-to-point from Ehrwald over Gatterl and across the Zugspitzplatt, finishing with a short via ferrata and an unsecured ridge to Schneefernerkopf.",
      "de": "Lange Streckentour von Ehrwald über das Gatterl und das Zugspitzplatt, zum Schluss über einen kurzen Klettersteig und einen unversicherten Grat auf den Schneefernerkopf."
    },
    "difficulty": {
