#KONSOLEH AREA START - PLEASE DO NOT EDIT MANUALLY BETWEEN THESE LINES
ErrorDocument 404 /404.html
DirectoryIndex index.html
#KONSOLEH AREA END - PLEASE ADD MANUAL CHANGES BELOW

# http -> https is already handled upstream by the host, so there is no rule for
# it here; adding one risks a loop where TLS is terminated by a proxy.
<IfModule mod_rewrite.c>
	RewriteEngine On

	# www -> apex. Without this, www. serves a full duplicate of the site with a
	# 200, leaving canonical tags as the only thing pointing at the real host.
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
	# Post sources, tracks and LaTeX artifacts: still fetchable — the maps read
	# some of these at runtime — but never worth indexing on their own.
	<FilesMatch "\.(tex|log|aux|out|sty)$"> # md|gpx|
		Header set X-Robots-Tag "noindex"
	</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
	# Text formats compress well; images/video/fonts below are already
	# compressed, so gzipping them again would waste CPU for no gain.
	AddOutputFilterByType DEFLATE text/html text/css text/plain
	AddOutputFilterByType DEFLATE text/javascript application/javascript
	AddOutputFilterByType DEFLATE application/json
	AddOutputFilterByType DEFLATE image/svg+xml
	AddOutputFilterByType DEFLATE application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On

	# Photos and fonts aren't content-hashed - a later re-run of
	# scripts/image_optimize.py could change a same-named file's bytes, so
	# this stays well short of a year and is not marked immutable. Listed
	# before the /_app/immutable/ rule below so that rule (more specific,
	# and the only one of the two that's actually safe to mark immutable)
	# applies last and wins for any hashed asset whose extension also
	# happens to match here (e.g. a font or icon under /_app/immutable/).
	<FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico|woff2?|ttf)$">
		ExpiresDefault "access plus 30 days"
		<IfModule mod_headers.c>
			Header set Cache-Control "public, max-age=2592000"
		</IfModule>
	</FilesMatch>

	# Vite content-hashes every file under /_app/immutable/, so a new
	# deploy always gets a new URL - safe to cache forever.
	<If "%{REQUEST_URI} =~ m#^/_app/immutable/#">
		ExpiresDefault "access plus 1 year"
		<IfModule mod_headers.c>
			Header set Cache-Control "public, max-age=31536000, immutable"
		</IfModule>
	</If>
</IfModule>
